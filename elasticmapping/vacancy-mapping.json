{
  "settings": {
    "analysis": {
      "analyzer": {
        "ru_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "russian_stop",
            "russian_stemmer",
            "russian_lemmatizer"
          ]
        }
      },
      "filter": {
        "russian_stop": {
          "type": "stop",
          "stopwords": "_russian_"
        },
        "russian_stemmer": {
          "type": "stemmer",
          "language": "russian"
        },
        "russian_lemmatizer": {
          "type": "stemmer",
          "language": "light_russian"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": { "type": "keyword" },
      "companyId": { "type": "keyword" },

      "post": { "type": "text", "analyzer": "ru_analyzer" },
      "description": {
        "type": "text",
        "analyzer": "ru_analyzer"
      },

      "minSalary": { "type": "integer" },
      "maxSalary": { "type": "integer" },
      "experience": { "type": "integer" },
      "educationId": {"type": "integer"},
      "educationName": { "type": "keyword" },
      "incomeDate": { "type": "date" },

      "workFormat": { "type": "keyword" },
      "workHour": { "type": "keyword" },

      "location": { "type": "geo_point" },

      "company": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "name": {
            "type": "text",
            "analyzer": "ru_analyzer"
          },
          "email": {"type": "keyword"},
          "phoneNumber" : {"type": "keyword"},
          "website": {"type": "keyword"}
        }
      },

      "activities": {
        "type": "nested",
        "properties": {
          "direction": { "type": "keyword" },
          "type": { "type": "keyword" }
        }
      }
    }
  }
}