{
  "settings": {
    "analysis": {
      "analyzer": {
        "ru_analyzer": {
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "russian_stop",
            "russian_stemmer"
          ]
        },
        "code_analyzer": {
          "tokenizer": "code_tokenizer",
          "filter": [
            "lowercase"
          ]
        }
      },
      "tokenizer": {
        "code_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 10,
          "token_chars": [
            "letter",
            "digit",
            "symbol",
            "punctuation"
          ]
        }
      },
      "filter": {
        "russian_stop": {
          "type": "stop",
          "stopwords": "_russian_"
        },
        "russian_stemmer": {
          "type": "stemmer",
          "language": "russian"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": { "type": "keyword" },

      "post": {
        "type": "text",
        "analyzer": "ru_analyzer",
        "search_analyzer": "ru_analyzer",
        "fields": {
          "code": {                
            "type": "text",
            "analyzer": "code_analyzer",
            "search_analyzer": "standard"
          }
        }
      },

      "description": {
        "type": "text",
        "analyzer": "ru_analyzer",
        "search_analyzer": "ru_analyzer",
        "fields": {
          "code": {
            "type": "text",
            "analyzer": "code_analyzer",
            "search_analyzer": "standard"
          }
        }
      },

      "experience": { "type": "integer" },
      "minSalary": { "type": "integer" },
      "maxSalary": { "type": "integer" },

      "educationId": { "type": "integer" },
      "educationName": { "type": "keyword" },

      "incomeDate": { "type": "date" },

      "workFormat": { "type": "keyword" },
      "workHour":   { "type": "keyword" },

      "company": {
        "properties": {
          "id": { "type": "keyword" },
          "name": {
            "type": "text",
            "analyzer": "ru_analyzer",
            "search_analyzer": "ru_analyzer"
          },
          "email": { "type": "keyword" },
          "phoneNumber": { "type": "keyword" },
          "website": { "type": "keyword" }
        }
      },

      "location": { "type": "geo_point" },

      "activities": {
        "type": "nested",
        "properties": {
          "id": { "type": "integer" },
          "direction": {
            "type": "text",
            "analyzer": "ru_analyzer"
          },
          "type": {
            "type": "text",
            "analyzer": "ru_analyzer"
          }
        }
      },

      "vector": {
        "type": "dense_vector",
        "dims": 768,
        "index": true,
        "similarity": "cosine",
        "index_options": {
          "type": "hnsw",
          "m": 16,
          "ef_construction": 100
        }
      }
    }
  }
}